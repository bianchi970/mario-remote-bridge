# MARIO Remote Bridge — env di esempio
# Copia in .env e personalizza

# Token che il Pi usa per autenticarsi al bridge (WS)
BRIDGE_AGENT_TOKEN=cambia-questo-token-segreto-pi

# Token che mario-web usa per chiamare il relay (HTTP)
BRIDGE_RELAY_TOKEN=cambia-questo-token-segreto-web

# Porte (opzionali, default: 7001 WS, 7002 HTTP relay)
AGENT_PORT=7001
RELAY_PORT=7002
