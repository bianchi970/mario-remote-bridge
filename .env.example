# MARIO Remote Bridge — env di esempio
# Copia in .env e personalizza

# ── Server (VPS) ─────────────────────────────────────────────────────────────

# Token che il Pi usa per autenticarsi al bridge (WS)
BRIDGE_AGENT_TOKEN=cambia-questo-token-segreto-pi

# Token che mario-web usa per chiamare il relay (HTTP)
BRIDGE_RELAY_TOKEN=cambia-questo-token-segreto-web

# Porte (opzionali, default: 7001 WS, 7002 HTTP relay)
AGENT_PORT=7001
RELAY_PORT=7002

# ── Client Pi (copiare in .env sul Pi) ───────────────────────────────────────

# URL WebSocket del bridge (es. ws://bridge.example.it:7001)
# MARIO_BRIDGE_URL=ws://bridge.example.it:7001

# Token agente (deve corrispondere a BRIDGE_AGENT_TOKEN sul server)
# MARIO_BRIDGE_TOKEN=cambia-questo-token-segreto-pi

# Identificatore univoco di questo impianto — usato per il routing multi-hub
# Deve essere univoco se si gestiscono più impianti sullo stesso bridge
# HUB_ID=default

# URL hub locale (default: http://localhost:4001)
# HUB_URL=http://localhost:4001
